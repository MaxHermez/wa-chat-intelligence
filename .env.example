# wa-chat-intelligence — environment configuration
#
# Environment variables are the LOWEST priority fallback.
# Prefer wain config set <key> <value> to write ~/.wain/config.toml instead.
# Resolution order: CLI args > workspace config.toml > global config.toml > env vars
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then source it before running any script:
#   source .env
#
# All variables are optional. Defaults (shown below as comments) use
# paths relative to the project directory and work out of the box.

# ── Required ──────────────────────────────────────────────────────────────────

# Your OpenAI API key — needed for summarizer.py and embedder.py.
OPENAI_API_KEY=sk-...

# ── WhatsApp export ───────────────────────────────────────────────────────────

# Directory containing the unzipped WhatsApp export.
# Media files (images, audio, etc.) are expected here.
# Default: <project_dir>/export/
CHAT_EXPORT_DIR=/path/to/whatsapp-export/

# The main chat .txt file from the export.
# Default: <CHAT_EXPORT_DIR>/_chat.txt
CHAT_TXT_FILE=/path/to/whatsapp-export/_chat.txt

# ── Database and index ────────────────────────────────────────────────────────

# SQLite database file — messages, chunks, and summaries are stored here.
# Default: <project_dir>/data/chat.db
DB_PATH=./data/chat.db

# FAISS vector index file.
# Default: <project_dir>/data/chat.faiss
INDEX_PATH=./data/chat.faiss

# FAISS index metadata (maps embedding IDs to chunk IDs).
# Default: <project_dir>/data/chat_faiss_meta.json
META_PATH=./data/chat_faiss_meta.json

# ── Sender identity ───────────────────────────────────────────────────────────

# Canonical display name for yourself in the output.
# Default: Me
SENDER_SELF=Alice

# Canonical display name for the other person.
# Default: Them
SENDER_OTHER=Bob

# Comma-separated list of raw sender names from the WhatsApp export that
# should be treated as SENDER_SELF. Case-insensitive.
# Example: if your export shows your messages as "Alice" or "Al":
#   SENDER_SELF_RAW=Alice,Al
# Default: the value of SENDER_SELF
SENDER_SELF_RAW=Alice

# Optional: free-text description of the conversation participants injected
# into the summarizer system prompt. Describe names, relationship, context.
# If unset, a generic "between {SENDER_SELF} and {SENDER_OTHER}" line is used.
# SUMMARIZER_CONTEXT=Alice is a software engineer in Berlin. Bob is her partner in London. Long-distance relationship since 2024.
FAISS_THRESHOLD=0.20   # cosine similarity gate; lower = wider recall

# ── Pipeline state ────────────────────────────────────────────────────────────

# File that records the last-run timestamp for each pipeline stage.
# Default: <project_dir>/data/pipeline_state.json
# STATE_PATH=./data/pipeline_state.json

# ── Voice note transcription ──────────────────────────────────────────────────

# Whisper backend to use for voice note transcription.
# 'local' uses the whisper CLI installed on your PATH (no API cost).
# 'api'   uses OpenAI's Whisper API (requires OPENAI_API_KEY, costs tokens).
# Default: local
# WHISPER_BACKEND=local

# Whisper model size (local backend) or API model name.
# Local options: tiny, base, small, medium, large
# API option:    whisper-1
# Default: base
# WHISPER_MODEL=base

# Language hint passed to Whisper (ISO 639-1 code, e.g. 'en', 'ru', 'de').
# Leave empty to let Whisper auto-detect.
# Default: (empty — auto-detect)
# WHISPER_LANGUAGE=

# ── Multi-workspace ───────────────────────────────────────────────────────────

# Default workspace name. Equivalent to always passing --workspace <name>.
# Unset means use the default single-workspace paths (DB_PATH etc.).
# WAINTEL_WORKSPACE=alice

# Root directory for all named workspaces.
# Each workspace is stored as a subdirectory: <root>/<name>/
# Default: ~/.wain/workspaces/
# WAINTEL_WORKSPACE_ROOT=~/.wain/workspaces/

# ── Hybrid search weights ─────────────────────────────────────────────────────

# Weights for hybrid search (semantic FAISS + keyword FTS5 combined scoring).
# Combined score = SEMANTIC_WEIGHT * cosine_score + KEYWORD_WEIGHT * bm25_score
# Must not necessarily sum to 1.0 — but the defaults do.
# Default: 0.7 (semantic) / 0.3 (keyword)
# WAINTEL_HYBRID_SEMANTIC_WEIGHT=0.7
# WAINTEL_HYBRID_KEYWORD_WEIGHT=0.3

# ── Model selection ───────────────────────────────────────────────────────────

# LLM model used to generate chunk summaries.
# Default: gpt-5-mini
# WAINTEL_SUMMARIZER_MODEL=gpt-5-mini

# OpenAI embedding model used to build the FAISS index.
# ⚠ Changing this requires re-embedding all chunks (wain embed --force)
#   because vector dimensions differ between models.
# Default: text-embedding-3-small (1536 dims)
# WAINTEL_EMBEDDING_MODEL=text-embedding-3-small

# ── Vision / image description ────────────────────────────────────────────────

# Backend for image description. Set to 'none' to skip without error.
# Default: api (calls OpenAI vision API)
# VISION_BACKEND=api

# Vision model used for image description.
# Default: gpt-5.2
# VISION_MODEL=gpt-5.2

# ── Date format ───────────────────────────────────────────────────────────────

# WhatsApp date order in the export. Set to 'false' for US exports (MM/DD/YYYY).
# Default: true (DD/MM/YYYY — used in most regions outside the US)
# WAINTEL_DATE_DAYFIRST=true
